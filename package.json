{
  "name": "balancr",
  "version": "2.5.4",
  "private": true,
  "description": "Self-hosted AI budget and portfolio advisor for Actual Budget and Ghostfolio",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.21.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json && node scripts/copy-assets.mjs",
    "build:web": "vite build --config web/vite.config.ts && node scripts/check-web-assets.mjs",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit && tsc -p web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "tokens:write": "tsx scripts/write-tokens.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "auth:local": "tsx --env-file-if-exists=.env scripts/local-user.ts",
    "i18n:check": "tsx scripts/check-i18n.ts",
    "badges:check": "node scripts/check-badges.mjs",
    "changelog:check": "tsx scripts/check-changelog.ts",
    "contrast:check": "tsx scripts/check-contrast.ts",
    "skips:check": "tsx scripts/check-test-skips.ts",
    "licenses:check": "tsx scripts/check-licenses.ts",
    "allow-scripts:check": "tsx scripts/check-allow-scripts.ts",
    "probe": "tsx --env-file-if-exists=.env scripts/probe.ts",
    "fake:ghostfolio": "tsx scripts/fake-backend/ghostfolio-server.ts",
    "fake:seed": "tsx --env-file-if-exists=.env scripts/fake-backend/seed-benchmark-custody.ts",
    "backup:verify": "tsx --env-file-if-exists=.env scripts/backup-verify.ts",
    "backup:restore": "tsx --env-file-if-exists=.env scripts/backup-restore.ts"
  },
  "dependencies": {
    "@actual-app/api": "26.10.0",
    "@actual-app/core": "26.10.0",
    "@fastify/cookie": "^11.1.2",
    "@fastify/helmet": "^13.1.1",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/static": "^10.1.5",
    "@google/genai": "^2.27.0",
    "argon2": "^0.45.1",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "fastify": "^5.12.5",
    "i18next": "^26.4.2",
    "ipaddr.js": "^2.5.0",
    "nodemailer": "^10.0.14",
    "openid-client": "^6.8.8",
    "otpauth": "^9.5.2",
    "pdfkit": "^0.20.2",
    "pino": "^10.3.1",
    "svg-to-pdfkit": "^0.1.8",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/license-checker": "^25.0.6",
    "@types/node": "^26.6.4",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-react": "^6.1.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "jose": "^6.2.12",
    "jsdom": "^30.1.1",
    "license-checker": "^25.0.1",
    "pino-pretty": "^13.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.15",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vitest": "^5.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nrosier/balancr.git"
  },
  "overrides": {
    "esbuild": ">=0.28.2",
    "protobufjs@<=8.7.2": "8.8.0"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "better-sqlite3@12.11.1": true,
    "argon2@0.45.1": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "@google/genai@2.27.0": true
  }
}
